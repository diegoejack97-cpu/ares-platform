{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "deploy/backend.Dockerfile" },
  "deploy": {
    "startCommand": "python -m uvicorn ares.fake_crm_sandbox.app:app --host :: --port 8010 --no-access-log",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
