# Copy to deploy/.env (ignored). Replace every placeholder before publishing.
ARES_PUBLIC_HOST=demo.example.com
ARES_ENVIRONMENT=demonstration
ARES_EVENT_JOURNAL_BACKEND=postgres
ARES_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-SUPABASE-HOST:5432/postgres?sslmode=require
ARES_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
ARES_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_KEY
ARES_SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_KEY
ARES_TENANT_ID=20000000-0000-0000-0000-000000000001
ARES_CORS_ORIGINS=["https://demo.example.com"]
ARES_TICK_SECRET=REPLACE_WITH_RANDOM_SECRET
ARES_CRM_PROVIDER=http_fake
ARES_FAKE_CRM_BASE_URL=http://crm:8010
ARES_FAKE_CRM_API_KEY=REPLACE_WITH_RANDOM_SECRET
ARES_FAKE_CRM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
ARES_FAKE_CRM_TIMEOUT_SECONDS=5
ARES_CRM_SECRET_DEMO_API=REPLACE_WITH_SAME_FAKE_CRM_API_KEY
ARES_CRM_SECRET_DEMO_WEBHOOK=REPLACE_WITH_SAME_FAKE_CRM_WEBHOOK_SECRET
ARES_CRM_CONNECTIONS={"20000000-0000-0000-0000-000000000001":{"connection_id":"REPLACE_WITH_COMPANY_CONNECTION_UUID","base_url":"http://crm:8010","api_key_env":"ARES_CRM_SECRET_DEMO_API","webhook_secret_env":"ARES_CRM_SECRET_DEMO_WEBHOOK"}}
ARES_OPENAI_API_KEY=
ARES_OPENAI_MODEL=gpt-5.4
ARES_RECOMMENDATION_ESTIMATED_COST_USD=0.01
ARES_WORKER_POLL_SECONDS=5
ARES_WORKER_STALE_SECONDS=180
ARES_REQUIRE_WORKER=true
ARES_BACKGROUND_EXECUTION=false
ARES_RATE_LIMIT_REQUESTS_PER_MINUTE=120
ARES_RATE_LIMIT_WRITES_PER_MINUTE=20
ARES_RATE_LIMIT_CHAT_PER_MINUTE=6
# Pre-authentication guard per observed ASGI peer, per process. See security audit.
ARES_RATE_LIMIT_IP_PER_MINUTE=600
