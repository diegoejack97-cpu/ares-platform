{$ARES_PUBLIC_HOST} {
    encode zstd gzip
    request_body {
        max_size 1048576
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' {$ARES_SUPABASE_URL}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:"
    }
    @backend path /api/* /health/*
    handle @backend {
        header Cache-Control "no-store"
        reverse_proxy api:8000
    }
    @assets path /assets/*
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv
        file_server
    }
    handle {
        header Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
